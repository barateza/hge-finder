# HGE Notifier Configuration - Phase 1 Ready

# =====================================================
# PHASE 1: REAL DATA INTEGRATION
# =====================================================

# Enable/disable real EDDN data (Phase 1)
# Set to 'false' to use real EDDN ZMQ stream
# Set to 'true' to use mock data for testing
EDDN_MOCK_MODE=false

# Elite Dangerous journal directory (Phase 1)
# Required for real-time location tracking
# Windows: C:\Users\{YourUsername}\Saved Games\Frontier Developments\Elite Dangerous
# macOS: ~/Library/Application Support/Frontier Developments/Elite Dangerous/
# Linux: ~/.local/share/Frontier Developments/Elite Dangerous/
JOURNAL_PATH=C:\Users\YourUsername\Saved Games\Frontier Developments\Elite Dangerous

# =====================================================
# WEB SERVER SETTINGS
# =====================================================

WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_DEBUG=false

# =====================================================
# LOGGING AND PERFORMANCE
# =====================================================

# Refresh interval for CLI and web updates (seconds)
REFRESH_INTERVAL=10

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional log file path
LOG_FILE=

# =====================================================
# COORDINATE DATABASE (Phase 1)
# =====================================================

# EDSM API timeout (seconds)
# No API key needed - uses public EDSM API
EDSM_API_TIMEOUT=5

# =====================================================
# FUTURE CONFIGURATION (Phase 2+)
# =====================================================

# Discord webhook URL for notifications
# DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID

# Email notification settings
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFICATION_EMAIL=alert@example.com

# =====================================================
# NOTES
# =====================================================
# 1. JOURNAL_PATH is required for Phase 1 real data
# 2. EDDN connection is automatic (tcp://eddn.edcd.io:9500)
# 3. System coordinates automatically cached to data/coordinates.db
# 4. See PHASE1_GUIDE.md for complete setup instructions
